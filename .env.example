# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql://arbitrage:arbitrage_dev@localhost:5432/sneaker_arbitrage
DB_PASSWORD=arbitrage_dev

# App settings
HOST=0.0.0.0
PORT=8000

# Arbitrage thresholds
MIN_MARGIN_THRESHOLD=10.0 # Minimum DOLLARS of margin (resale - fees - effective price) to flag an opportunity
ROI_THRESHOLD=20.0        # Display/filter threshold only (margin is the gate)
COMMISSION_RATE=0.12      # Generic fee estimate for GOAT/Alias (StockX uses app/stockx_fees.py)

# Sales-liquidity gate (README §Sales liquidity) — a margin-positive product
# only surfaces when it is actually selling.
LIQUIDITY_MIN_SALES_7D=1          # eligible when >= this many sales in the last 7 days ...
LIQUIDITY_MIN_SALES_30D=5         # ... OR >= this many in the last 30 days
LIQUIDITY_ALLOW_UNKNOWN_WITH_BID=true  # when sales counts are unavailable, accept a live highest bid as demand proxy; false = strict exclusion

# StockX official API (developer.stockx.com) — see README §StockX API
# Get these from your StockX developer app; capture the refresh token once
# with: python scripts/stockx_auth.py
STOCKX_CLIENT_ID=
STOCKX_CLIENT_SECRET=
STOCKX_API_KEY=
STOCKX_REFRESH_TOKEN=     # optional backup — the DB copy is authoritative after first auth
STOCKX_REDIRECT_URI=http://localhost:8017/stockx/callback
STOCKX_SELLER_LEVEL=1     # 1-5, picks your transaction-fee tier (app/stockx_fees.py)
STOCKX_MARKET_TTL_HOURS=8 # re-check StockX market data after this long (6-12h sane band)
STOCKX_LOOKUP_CONCURRENCY=2

# Cart validation (README §Cart validation & inventory confidence)
CART_VALIDATION_ENABLED=true    # per-size add-to-cart check for opportunity candidates
REQUIRE_CART_VERIFICATION=true  # definitive cart rejection excludes the opportunity

# Scraping settings (seconds between requests to the same site)
SCRAPE_DELAY_MIN=1.5
SCRAPE_DELAY_MAX=4.0

# How often to run the full scrape (minutes)
SCRAPE_INTERVAL_MINUTES=60

# Market data APIs
KICKS_DEV_API_KEY=       # https://kicks.dev/ — StockX + GOAT pricing
ALIAS_API_KEY=           # https://alias.org/ — pricing + sales volume fallback

# eBay Buy APIs (developer.ebay.com) — DEMAND PROXIES ONLY. eBay has no public
# API for market-wide sold-item history (confirmed by eBay dev support, July
# 2026), so these power active-listing ask stats + watch/merchandising demand
# signals, never sold prices or the sales-liquidity gate. app/scrapers/ebay.py.
EBAY_APP_ID=             # eBay "App ID" (Client ID)
EBAY_CERT_ID=            # eBay "Cert ID" (Client Secret)
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_SNEAKER_CATEGORY_ID=15709  # category behind the merchandised-product demand rank
EBAY_MARKET_TTL_HOURS=12 # per-SKU TTL for eBay context lookups (secondary data, slow refresh)
