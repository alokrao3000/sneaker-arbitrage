# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql://arbitrage:arbitrage_dev@localhost:5432/sneaker_arbitrage
DB_PASSWORD=arbitrage_dev

# App settings
HOST=0.0.0.0
PORT=8000

# Arbitrage thresholds
MIN_MARGIN_THRESHOLD=10.0 # Minimum DOLLARS of margin (resale - fees - effective price) to flag an opportunity
ROI_THRESHOLD=20.0        # Display/filter threshold only (margin is the gate)
COMMISSION_RATE=0.12      # Generic fee estimate for GOAT/Alias (StockX uses app/stockx_fees.py)

# StockX official API (developer.stockx.com) — see README §StockX API
# Get these from your StockX developer app; capture the refresh token once
# with: python scripts/stockx_auth.py
STOCKX_CLIENT_ID=
STOCKX_CLIENT_SECRET=
STOCKX_API_KEY=
STOCKX_REFRESH_TOKEN=     # optional backup — the DB copy is authoritative after first auth
STOCKX_REDIRECT_URI=http://localhost:8017/stockx/callback
STOCKX_SELLER_LEVEL=1     # 1-5, picks your transaction-fee tier (app/stockx_fees.py)
STOCKX_MARKET_TTL_HOURS=8 # re-check StockX market data after this long (6-12h sane band)
STOCKX_LOOKUP_CONCURRENCY=2

# Scraping settings (seconds between requests to the same site)
SCRAPE_DELAY_MIN=1.5
SCRAPE_DELAY_MAX=4.0

# How often to run the full scrape (minutes)
SCRAPE_INTERVAL_MINUTES=60

# Market data APIs
KICKS_DEV_API_KEY=       # https://kicks.dev/ — StockX + GOAT pricing
ALIAS_API_KEY=           # https://alias.org/ — pricing + sales volume fallback
